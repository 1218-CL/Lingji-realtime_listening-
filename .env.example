# 复制为 .env 后再启动 docker compose
# 生成方式：openssl rand -base64 48
# 必须填写；留空时 compose 会直接报错，避免用弱密钥上线
APP_SECRET=

# 通过 Caddy / Nginx 提供 HTTPS 时保持 true
COOKIE_SECURE=true

# 反向代理后设为 true，用于正确的客户端 IP 与限流
TRUST_PROXY=true

# 公开部署不要创建 demo/demo1234 账号
SEED_DEMO=false

# 可选：本地直接访问、不做 HTTPS 调试时改成 false
# COOKIE_SECURE=false

# Caddyfile 中使用的域名（Caddy 不读取此变量，请同时修改配置）
# DOMAIN=lingji.example.com

# 更新清单地址（公网 HTTPS JSON）。不设置则客户端不检查更新。
# 构建 exe 时也要设置同名变量，地址才会写进桌面应用。
UPDATE_MANIFEST_URL=
